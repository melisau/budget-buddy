# Settings for deploy/vds/backup.sh. On the server copy this to
# /opt/budgetbuddy/backup.env (chmod 600, owned by root) and fill it in.
# Never commit the filled-in file. See docs/vds.md ("Database and file backups").

# Production database, read-only use. Supabase Dashboard > Connect > "Session pooler"
# (IPv4; the direct connection is IPv6-only on the free plan). Replace [PASSWORD]
# with the database password. Keep the value only in this file on the server.
BACKUP_DATABASE_URL=postgresql://postgres.fnhzuvhjpnothuuzbnkv:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Where dumps and the Storage mirror are kept on the server, and for how long.
BACKUP_DIR=/var/backups/budgetbuddy
BACKUP_KEEP_DAYS=14

# rclone settings file holding the remotes named below (chmod 600).
BACKUP_RCLONE_CONFIG=/opt/budgetbuddy/rclone.conf

# Receipt and avatar files: an rclone remote for the project's Storage S3
# endpoint. Leave empty to skip files (database only).
BACKUP_STORAGE_REMOTE=supabase
BACKUP_STORAGE_BUCKETS="budgetbuddy-receipts budgetbuddy-avatars"

# Off-site copy: an rclone remote and path, ideally an encrypted (crypt) remote.
# Leave empty to keep backups only on this server (not recommended).
BACKUP_REMOTE=offsite:
BACKUP_REMOTE_KEEP_DAYS=60

# Optional: a healthchecks.io (or similar) ping URL. Pinged on success,
# "<url>/fail" on failure; it alerts you when a day's backup is missing.
BACKUP_HEALTHCHECK_URL=
