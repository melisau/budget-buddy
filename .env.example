# Copy this file to .env.local for local development. Never commit real values.
# Development/Preview and Production must use separate service instances and keys.

# Canonical public URL (metadata, sitemap). Production: https://budgetbuddy.melisauyar.com
NEXT_PUBLIC_SITE_URL=

# Public project URL. Preview must point to the Dev Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
# Public Auth key from the SAME project (publishable or legacy anon key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring the Google provider in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Server-only privileged key. Production data must not be used locally or in Preview.
SUPABASE_SECRET_KEY=

# Groq runs the assistant in the cloud. Keep the API key server-only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Stripe is optional during local development. Use Sandbox/Test outside Production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Optional Sentry DSN (Project Settings > Client Keys). Server-only; leave empty
# to disable forwarding. Errors are always stored in Supabase error_events too.
SENTRY_DSN=

# Paid plans stay off until Stripe is verified in production. Set to true and
# redeploy to show paid pricing and enable Stripe Checkout.
NEXT_PUBLIC_BILLING_ENABLED=false
