# Copy this file to .env.local for local development. Never commit real values.
# Development/Preview and Production must use separate service instances and keys.

# Public Clerk value. Use a Development instance locally and in Preview.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only Clerk secret. Never expose it through NEXT_PUBLIC_*.
CLERK_SECRET_KEY=

# Public project URL. Preview must point to the Dev Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only privileged key. Production data must not be used locally or in Preview.
SUPABASE_SECRET_KEY=

# Groq runs the assistant in the cloud. Keep the API key server-only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Stripe is optional during local development. Use Sandbox/Test outside Production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Optional: set this in production when an error-monitoring provider is configured.
NEXT_PUBLIC_ERROR_REPORTING_DSN=
