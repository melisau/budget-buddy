# Development and production use separate Clerk and Supabase projects.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Use the local Ollama URL only for local development.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Stripe is optional during local development. Configure all values before enabling payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Optional: set this in production when an error-monitoring provider is configured.
NEXT_PUBLIC_ERROR_REPORTING_DSN=
