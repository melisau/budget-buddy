# Copy this file to .env.local for local development. Never commit real values.
# Local development and Production must use separate Supabase instances and keys.

# Canonical public URL (metadata, sitemap). Production: https://budgetbuddy.melisauyar.com
NEXT_PUBLIC_SITE_URL=

# Public project URL. Local runs use the local Supabase stack (supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Public Auth key from the SAME project (publishable or legacy anon key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring the Google provider in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Optional: Google OAuth Web client ID for the on-site Google button (Google Identity Services).
# Add the site origin under "Authorized JavaScript origins". Without it the redirect flow is used.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-only privileged key. Production data must not be used locally.
SUPABASE_SECRET_KEY=

# Groq runs the assistant in the cloud. Keep the API key server-only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Sentry DSN (Project Settings > Client Keys). Server-only; leave empty
# to disable forwarding. Errors are always stored in Supabase error_events too.
SENTRY_DSN=

# Notifications. In-app notifications need nothing here. E-mail (budget and goal
# reminders, family invitations) is sent only when SMTP is configured; without
# it the app works and simply skips e-mail. Local: the Supabase inbox at
# SMTP_HOST=127.0.0.1, SMTP_PORT=54325 (messages appear at http://127.0.0.1:54324).
# Production (Resend): SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend,
# SMTP_PASSWORD=<Resend API key>, SMTP_FROM on the verified sending domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# Shared secret (16+ characters) for the daily notification job,
# POST /api/cron/notifications with "Authorization: Bearer <secret>".
# Without it the endpoint answers 503. Generate one: openssl rand -hex 24
CRON_SECRET=

# Paid plans stay off: no payment provider is connected yet. Keep this false;
# every user has full access while it is false.
NEXT_PUBLIC_BILLING_ENABLED=false

# Production backups (deploy/vds/backup.sh) are configured on the server in
# /opt/budgetbuddy/backup.env, not here: see deploy/vds/backup.env.example and
# docs/vds.md. The app itself needs no backup variables.
